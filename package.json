{
  "name": "@stratabook/mcp",
  "version": "0.2.21",
  "description": "Connect AI agents to Strata markets and Sonar quotes with MCP.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://stratabook.org/docs/agent-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsk1992/strata-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alsk1992/strata-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "strata-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pack:check": "npm pack --dry-run",
    "ci": "npm test && npm run pack:check",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stratabook/sdk": "0.2.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2"
  }
}
